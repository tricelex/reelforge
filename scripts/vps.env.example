# Local connection config for scripts/vps-*.sh helper scripts.
#
# Copy this to scripts/vps.env (already gitignored via the *.env pattern —
# never commit real values) and fill in your VPS details:
#
#   cp scripts/vps.env.example scripts/vps.env
#
# Requires your personal SSH key to already be in the `deploy` user's
# authorized_keys on the VPS (set up during vps-bootstrap.sh, step 1 of
# docs/deployment/vps-deployment-guide.md).

VPS_HOST=203.0.113.10
VPS_USER=deploy
VPS_APP_DIR=/opt/***REMOVED***
