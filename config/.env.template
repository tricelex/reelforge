# Security Warning! Do not commit this file to any VCS!
# This is a local file to speed up development process,
# so you don't have to change your environment variables.
#
# This is not applied to `.env.template`!
# Template files must be committed to the VCS, but must not contain
# any secret values.


# === General ===

DOMAIN_NAME=app.***REMOVED***.com


# === Django ===

# Generate yours with:
# python3 -c 'from django.utils.crypto import get_random_string; print(get_random_string(50))'
DJANGO_SECRET_KEY=***REMOVED***


# === Database (external PostgreSQL) ===

POSTGRES_DB=***REMOVED***_dev
POSTGRES_USER=***REMOVED***
POSTGRES_PASSWORD=***REMOVED***
DJANGO_DATABASE_HOST=***REMOVED***
DJANGO_DATABASE_PORT=5432


# === Caddy ===

# We use this email to support HTTPS, certificate will be issued on this owner:
# See: https://caddyserver.com/docs/caddyfile/directives/tls
TLS_EMAIL=webmaster@app.***REMOVED***.com


# === Redis / RabbitMQ ===

REDIS_URL=redis://redis:6379
RABBITMQ_URL=***REMOVED***


# === Observability ===

# Django environment label (development, staging, production).
DJANGO_ENV=development

# Sentry error tracking — leave blank to disable.
# Get DSN from: https://sentry.io → Project Settings → Client Keys
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Logfire distributed tracing — leave blank to disable.
# Get token from: https://logfire.pydantic.dev → Project Settings → Write Tokens
LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=***REMOVED***


# === Storage (Cloudflare R2) ===
# Get credentials from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
# Account ID appears on the R2 overview page.

# R2 API token key (32 chars) and secret
AWS_ACCESS_KEY_ID=***REMOVED***
AWS_SECRET_ACCESS_KEY=***REMOVED***
AWS_STORAGE_BUCKET_NAME=***REMOVED***
# R2 S3-compatible endpoint: ***REMOVED***
AWS_S3_ENDPOINT_URL=***REMOVED***
# Browser-facing endpoint for presigned upload/download URLs.
# Usually the same as AWS_S3_ENDPOINT_URL for R2.
AWS_S3_PUBLIC_ENDPOINT_URL=***REMOVED***
# R2 requires region = "auto"
AWS_S3_REGION_NAME=auto
# R2 has valid TLS certs; always True in production
AWS_S3_VERIFY=true
# Public domain for static files — set to R2 public URL or custom CDN domain.
# Use the bare domain only — do NOT append the bucket name or a path prefix.
# Example: pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
AWS_S3_CUSTOM_DOMAIN=


# === Provider API keys ===

# OpenAI — Whisper transcription + LLM (clip analysis, ideation, etc.)
OPENAI_API_KEY=***REMOVED***

# HuggingFace — PyAnnote speaker diarization (optional; analysis continues without it)
HUGGINGFACE_TOKEN=***REMOVED***
