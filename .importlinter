# See https://github.com/seddonym/import-linter

[importlinter]
root_package = server
include_external_packages = True
exclude_type_checking_imports = True


[importlinter:contract:layers]
name = Layered architecture of our project
type = layers

containers =
  server.apps.*

layers =
  (urls) | (admin)
  (views) | (htmx) | (api)
  (tasks)
  (infra)
  (models)
  (logic)


[importlinter:contract:apps-independence]
name = All apps must be independent
type = independence

modules =
  server.apps.*

ignore_imports =
  # This is hack we have to use due to models relations
  server.apps.*.admin -> server.apps.*.models
  # Pipeline services need prompts/assets models; deferred runtime imports
  server.apps.pipelines.services.prompt_renderer -> server.apps.prompts.models
  server.apps.pipelines.services.asset_writer -> server.apps.assets.models
  # Pipeline stages use generation provider clients (generation is a client
  # library whose sole consumer is pipeline stages — cross-app by design)
  server.apps.pipelines.stages.research -> server.apps.generation.clients.llm
  server.apps.pipelines.stages.research -> server.apps.generation.clients.search
  server.apps.pipelines.stages.outline -> server.apps.generation.clients.llm
  server.apps.pipelines.stages.script -> server.apps.generation.clients.llm
  server.apps.pipelines.stages.scene_breakdown -> server.apps.generation.clients.llm
  server.apps.pipelines.stages.visual_prompts -> server.apps.generation.clients.llm
  server.apps.pipelines.stages.image_gen -> server.apps.generation.clients.fal
  server.apps.pipelines.stages.tts -> server.apps.generation.clients.elevenlabs
  server.apps.pipelines.stages.motion -> server.apps.generation.clients.fal
  server.apps.pipelines.stages.alignment -> server.apps.generation.clients.whisperx
  server.apps.pipelines.stages.music_plan -> server.apps.generation.clients.llm
  server.apps.pipelines.stages.thumbnail -> server.apps.generation.clients.fal
  server.apps.pipelines.stages.metadata -> server.apps.generation.clients.llm
  # Pipeline stages save assets and reference AssetKind from the assets app
  server.apps.pipelines.stages.image_gen -> server.apps.assets.models
  server.apps.pipelines.stages.tts -> server.apps.assets.models
  server.apps.pipelines.stages.motion -> server.apps.assets.models
  server.apps.pipelines.stages.alignment -> server.apps.assets.models
  server.apps.pipelines.stages.thumbnail -> server.apps.assets.models
  server.apps.pipelines.stages.music_plan -> server.apps.assets.models
  # Assembly + QC stages call rendering service layer
  server.apps.pipelines.stages.assembly -> server.apps.rendering.ffmpeg
  server.apps.pipelines.stages.qc -> server.apps.rendering.ffmpeg
  # Assembly and QC fetch Asset rows from the assets app
  server.apps.pipelines.stages.assembly -> server.apps.assets.models
  server.apps.pipelines.stages.qc -> server.apps.assets.models
  # Publish stage uploads to YouTube, needs assets, channels, generation, publishing
  server.apps.pipelines.stages.publish -> server.apps.assets.models
  server.apps.pipelines.stages.publish -> server.apps.channels.models
  server.apps.pipelines.stages.publish -> server.apps.generation.clients.youtube
  server.apps.pipelines.stages.publish -> server.apps.publishing.models
  # Analytics selectors aggregate live cost data from pipelines CostRecord
  server.apps.analytics.selectors -> server.apps.pipelines.models


[importlinter:contract:common-module-is-independent]
name = Common utilities cannot import things from apps
type = forbidden

source_modules =
  server.common

forbidden_modules =
  server.apps



[importlinter:contract:tests-restrictions]
name = Explicit import restrictions for tests
type = forbidden

source_modules =
  server

forbidden_modules =
  tests


[importlinter:contract:apps-cannot-import-services]
name = Apps must not import from the services layer
type = forbidden

source_modules =
  server.apps

forbidden_modules =
  server.services


[importlinter:contract:server-can-import-settings-directly]
name = Settings can be directly imported only in settings, use `django.conf`
type = protected

protected_modules =
  server.settings.**

allowed_importers =
  server.settings
